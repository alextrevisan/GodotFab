extends "res://tests/test_case.gd"
## Epic build manifest parser and chunk decoder, checked against fixtures
## generated by tests/fixtures/make_manifest_fixtures.py (expected.json).

const Manifest = preload("res://addons/godotfab/manifest.gd")
const FIXTURES := "res://tests/fixtures"


static func _fixture(name: String) -> PackedByteArray:
	return FileAccess.get_file_as_bytes(FIXTURES.path_join(name))


static func _expected() -> Dictionary:
	return read_json(FIXTURES.path_join("expected.json"))


static func _hash_hex(value: int) -> String:
	return "%08X%08X" % [(value >> 32) & 0xFFFFFFFF, value & 0xFFFFFFFF]


## Inverse of _hash_hex: 16 hex chars -> the u64 bit pattern as a (possibly negative) int.
static func _hex_to_u64(hex: String) -> int:
	return (("0x" + hex.substr(0, 8)).hex_to_int() << 32) | ("0x" + hex.substr(8, 8)).hex_to_int()


static func _sha1_hex(data: PackedByteArray) -> String:
	var ctx := HashingContext.new()
	ctx.start(HashingContext.HASH_SHA1)
	ctx.update(data)
	return ctx.finish().hex_encode()


func _check_parsed(result: Dictionary, feature_level: int, with_secrets: bool) -> void:
	var expected := _expected()
	assert_true(result.ok, "parse ok: %s" % result.get("error", ""))
	if not result.ok:
		return
	assert_eq(result.error, "", "no error")
	assert_eq(result.feature_level, feature_level, "feature level")
	assert_eq(result.build_version, expected.build_version, "build version")

	var chunks: Dictionary = result.chunks
	assert_eq(chunks.size(), expected.chunks.size(), "chunk count")
	for guid_hex in expected.chunks:
		var exp: Dictionary = expected.chunks[guid_hex]
		assert_true(chunks.has(guid_hex), "chunk %s present" % guid_hex)
		if not chunks.has(guid_hex):
			continue
		var chunk: Dictionary = chunks[guid_hex]
		assert_eq(Manifest.guid_hex(chunk.guid), guid_hex, "guid_hex round trip")
		assert_eq(chunk.guid.size(), 4, "guid has 4 parts")
		for i in 4:
			assert_eq(chunk.guid[i], int(exp.guid[i]), "guid part %d of %s" % [i, guid_hex])
		assert_eq(_hash_hex(chunk.hash), exp.hash_hex, "hash of %s" % guid_hex)
		assert_eq(chunk.group, int(exp.group), "group of %s" % guid_hex)
		if with_secrets and exp.secret_v22 != null:
			assert_true(chunk.secret is Array, "secret is an Array for %s" % guid_hex)
			if chunk.secret is Array:
				for i in 4:
					assert_eq(chunk.secret[i], int(exp.secret_v22[i]), "secret part %d of %s" % [i, guid_hex])
		elif with_secrets:
			# All-zero secret from the file: path must still be "plain".
			assert_eq(Manifest.chunk_path(chunk, 22), exp.path_v22, "plain path for zero secret")
		else:
			assert_null(chunk.secret, "no secret below feature level 22")
		assert_eq(Manifest.chunk_path(chunk, feature_level), exp["path_v%d" % feature_level], "chunk path of %s" % guid_hex)

	var files: Array = result.files
	assert_eq(files.size(), expected.files.size(), "file count")
	for i in mini(files.size(), expected.files.size()):
		var f: Dictionary = files[i]
		var exp_f: Dictionary = expected.files[i]
		assert_eq(f.filename, exp_f.filename, "filename %d" % i)
		assert_eq(f.size, int(exp_f.size), "size of %s" % exp_f.filename)
		assert_true(f.sha1 is PackedByteArray, "sha1 is bytes")
		assert_eq(f.sha1.size(), 20, "sha1 length")
		assert_eq(f.sha1.hex_encode(), exp_f.sha1_hex, "sha1 of %s" % exp_f.filename)
		assert_eq(f.parts.size(), exp_f.parts.size(), "part count of %s" % exp_f.filename)
		for j in mini(f.parts.size(), exp_f.parts.size()):
			var part: Dictionary = f.parts[j]
			var exp_p: Dictionary = exp_f.parts[j]
			assert_eq(part.guid, exp_p.guid, "part %d guid of %s" % [j, exp_f.filename])
			assert_eq(part.offset, int(exp_p.offset), "part %d offset of %s" % [j, exp_f.filename])
			assert_eq(part.size, int(exp_p.size), "part %d size of %s" % [j, exp_f.filename])


func test_parse_binary_v20() -> void:
	var data := _fixture("manifest_v20.manifest")
	assert_eq(data.decode_u32(0), Manifest.MANIFEST_MAGIC, "fixture starts with the manifest magic")
	_check_parsed(Manifest.parse(data), 20, false)


func test_parse_binary_v22() -> void:
	_check_parsed(Manifest.parse(_fixture("manifest_v22.manifest")), 22, true)


func test_parse_json() -> void:
	_check_parsed(Manifest.parse(_fixture("manifest.json")), 20, false)


func test_bad_magic_falls_back_to_json_and_errors() -> void:
	var result := Manifest.parse("not a manifest".to_utf8_buffer())
	assert_false(result.ok, "garbage is rejected")
	assert_true(result.error != "", "garbage has an error message")

	result = Manifest.parse("{}".to_utf8_buffer())
	assert_false(result.ok, "JSON without chunk lists is rejected")
	assert_true(result.error != "", "empty JSON has an error message")

	result = Manifest.parse(PackedByteArray())
	assert_false(result.ok, "empty data is rejected")

	# Binary magic but truncated body.
	var data := _fixture("manifest_v20.manifest")
	result = Manifest.parse(data.slice(0, 30))
	assert_false(result.ok, "truncated header is rejected")
	assert_true(result.error != "", "truncated header has an error message")

	# Hash mismatch: flip a byte of the header's SHA-1.
	data = _fixture("manifest_v20.manifest")
	data[16] = data[16] ^ 0xFF
	result = Manifest.parse(data)
	assert_false(result.ok, "hash mismatch is rejected")
	assert_contains(result.error.to_lower(), "hash", "hash mismatch message")

	# Encrypted flag (stored_as at offset 36).
	data = _fixture("manifest_v20.manifest")
	data[36] = data[36] | 0x2
	result = Manifest.parse(data)
	assert_false(result.ok, "encrypted manifest is rejected")
	assert_contains(result.error, "Encrypted", "encrypted message")


func test_decode_chunk_compressed() -> void:
	var expected := _expected()
	var result := Manifest.decode_chunk(_fixture("chunk_compressed.chunk"))
	assert_true(result.ok, "decode ok: %s" % result.get("error", ""))
	if not result.ok:
		return
	assert_eq(result.guid, expected.chunk_compressed.guid, "guid")
	assert_eq(result.payload.size(), int(expected.chunk_compressed.payload_size), "payload size")
	assert_eq(_sha1_hex(result.payload), expected.chunk_compressed.payload_sha1_hex, "payload sha1")


func test_decode_chunk_plain() -> void:
	var expected := _expected()
	var result := Manifest.decode_chunk(_fixture("chunk_plain.chunk"))
	assert_true(result.ok, "decode ok: %s" % result.get("error", ""))
	if not result.ok:
		return
	assert_eq(result.guid, expected.chunk_plain.guid, "guid")
	assert_eq(result.payload.size(), int(expected.chunk_plain.payload_size), "payload size")
	assert_eq(_sha1_hex(result.payload), expected.chunk_plain.payload_sha1_hex, "payload sha1")


func test_decode_chunk_encrypted_errors() -> void:
	# stored_as byte is at offset 4*4 + 16 + 8 = 40.
	var data := _fixture("chunk_compressed.chunk")
	data[40] = data[40] | 0x2
	var result := Manifest.decode_chunk(data)
	assert_false(result.ok, "encrypted chunk is rejected")
	assert_contains(result.error, "Encrypted", "encrypted message")

	result = Manifest.decode_chunk(PackedByteArray())
	assert_false(result.ok, "empty chunk is rejected")

	var zeros := PackedByteArray()
	zeros.resize(80)
	result = Manifest.decode_chunk(zeros)
	assert_false(result.ok, "bad magic is rejected")
	assert_contains(result.error, "magic", "bad magic message")

	result = Manifest.decode_chunk(_fixture("chunk_compressed.chunk").slice(0, 20))
	assert_false(result.ok, "truncated header is rejected")


func test_chunk_path_v4_and_v5() -> void:
	var expected := _expected()
	for guid_hex in expected.chunks:
		var exp: Dictionary = expected.chunks[guid_hex]
		var guid: Array = []
		for v in exp.guid:
			guid.append(int(v))
		var secret = null
		if exp.secret_v22 != null:
			secret = []
			for v in exp.secret_v22:
				secret.append(int(v))
		var chunk := {
			"guid": guid,
			"hash": _hex_to_u64(exp.hash_hex),
			"group": int(exp.group),
			"secret": secret,
		}
		assert_eq(Manifest.guid_hex(guid), guid_hex, "guid_hex")
		assert_eq(Manifest.chunk_path(chunk, 20), exp.path_v20, "v4 path of %s" % guid_hex)
		assert_eq(Manifest.chunk_path(chunk, 22), exp.path_v22, "v5 path of %s" % guid_hex)
		assert_eq(Manifest.chunk_path(chunk, 25), exp.path_v22, "v5 path for newer levels")
		if secret == null:
			chunk.secret = [0, 0, 0, 0]
			assert_eq(Manifest.chunk_path(chunk, 22), exp.path_v22, "zero secret is plain")
	# Older folders.
	var first: Dictionary = expected.chunks["11111111222222223333333344444444"]
	var c1 := {"guid": [0x11111111, 0x22222222, 0x33333333, 0x44444444], "hash": 0x0123456789ABCDEF, "group": 7, "secret": null}
	for level in expected.chunk_paths_by_level:
		assert_eq(Manifest.chunk_path(c1, int(level)), expected.chunk_paths_by_level[level], "path at level %s" % level)
	assert_eq(Manifest.chunk_path(c1, 20), first.path_v20, "level 20 is ChunksV4")


func test_safe_relative_path() -> void:
	assert_eq(Manifest.safe_relative_path("Content/A.uasset"), "Content/A.uasset", "plain path kept")
	assert_eq(Manifest.safe_relative_path("Content/Pack/Maps/Overview.umap"), "Content/Pack/Maps/Overview.umap", "nested path kept")
	assert_eq(Manifest.safe_relative_path("Content\\Pack\\A.uasset"), "Content/Pack/A.uasset", "backslashes normalized")
	assert_eq(Manifest.safe_relative_path("../x"), "", "parent segment rejected")
	assert_eq(Manifest.safe_relative_path("a/../b"), "", "inner parent segment rejected")
	assert_eq(Manifest.safe_relative_path("/x"), "", "absolute path rejected")
	assert_eq(Manifest.safe_relative_path("\\x"), "", "backslash absolute path rejected")
	assert_eq(Manifest.safe_relative_path("C:x"), "", "drive letter rejected")
	assert_eq(Manifest.safe_relative_path("C:\\x"), "", "drive path rejected")
	assert_eq(Manifest.safe_relative_path("a\\..\\b"), "", "backslash parent rejected")
	assert_eq(Manifest.safe_relative_path(""), "", "empty rejected")
	assert_eq(Manifest.safe_relative_path("a//b"), "", "empty segment rejected")
	assert_eq(Manifest.safe_relative_path("a/"), "", "trailing slash rejected")
	assert_eq(Manifest.safe_relative_path("..foo/bar"), "..foo/bar", "dots inside a name are fine")
